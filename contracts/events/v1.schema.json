{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stokora:event:1",
  "title": "STOKORA transaction envelope v1",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
    },
    "origin_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "ingestion_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "type": {
      "enum": [
        "sale_created",
        "sale_updated",
        "sale_cancelled",
        "stock_movement",
        "purchase_order_approved"
      ]
    },
    "operation": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "is_simulated": {
      "type": "boolean"
    },
    "synthetic_scenario_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "tenant_id",
    "site_id",
    "source",
    "origin_timestamp",
    "ingestion_timestamp",
    "type",
    "operation",
    "version",
    "is_simulated",
    "synthetic_scenario_id",
    "payload"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "is_simulated": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "synthetic_scenario_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
      }
    }
  },
  "else": {
    "properties": {
      "synthetic_scenario_id": {
        "type": "null"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "sale_created"
        },
        "operation": {
          "const": "create"
        },
        "payload": {
          "type": "object",
          "properties": {
            "sale_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
            },
            "revision": {
              "const": 1
            },
            "product_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "unit_price_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "currency": {
              "enum": [
                "USD",
                "MAD",
                "GBP",
                "EUR"
              ]
            }
          },
          "required": [
            "sale_id",
            "revision",
            "product_id",
            "quantity",
            "unit_price_minor",
            "currency"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "sale_updated"
        },
        "operation": {
          "const": "update"
        },
        "payload": {
          "type": "object",
          "properties": {
            "sale_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
            },
            "revision": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1000000
            },
            "product_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "unit_price_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "currency": {
              "enum": [
                "USD",
                "MAD",
                "GBP",
                "EUR"
              ]
            }
          },
          "required": [
            "sale_id",
            "revision",
            "product_id",
            "quantity",
            "unit_price_minor",
            "currency"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "sale_cancelled"
        },
        "operation": {
          "const": "cancel"
        },
        "payload": {
          "type": "object",
          "properties": {
            "sale_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
            },
            "revision": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1000000
            },
            "reason": {
              "enum": [
                "void",
                "return"
              ]
            }
          },
          "required": [
            "sale_id",
            "revision",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "stock_movement"
        },
        "operation": {
          "const": "record"
        },
        "payload": {
          "type": "object",
          "properties": {
            "product_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
            },
            "quantity_signed": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000,
              "not": {
                "const": 0
              }
            },
            "unit": {
              "const": "each"
            },
            "reason": {
              "enum": [
                "opening",
                "receipt",
                "sale",
                "return",
                "adjustment"
              ]
            }
          },
          "required": [
            "product_id",
            "quantity_signed",
            "unit",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "purchase_order_approved"
        },
        "operation": {
          "const": "approve"
        },
        "payload": {
          "type": "object",
          "properties": {
            "purchase_order_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
            },
            "product_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "currency": {
              "enum": [
                "USD",
                "MAD",
                "GBP",
                "EUR"
              ]
            },
            "approved_by": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}(?![\\s\\S])"
            },
            "approval_mode": {
              "const": "human"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "purchase_order_id",
            "product_id",
            "quantity",
            "currency",
            "approved_by",
            "approval_mode",
            "revision"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
